---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import { chapters, foundedCount, href, roles, site } from "../data/site";

const base = import.meta.env.BASE_URL;
const ventures = ["skyop", "dockside-net", "scientific-calculations"]
  .map((slug) => roles.find((role) => role.slug === slug))
  .filter((role) => role !== undefined);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: "https://pitre.com/",
  telephone: "+1-585-230-0550",
  jobTitle: "Managing Member and Co-Founder",
  worksFor: { "@type": "Organization", name: "SkyOp LLC" },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Canandaigua",
    addressRegion: "NY",
    addressCountry: "US",
  },
  description: site.description,
};
---

<Base preload={`${base}images/brian-on-the-water-1200.webp`}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="bg-sea-deep text-foam">
    <div class="mx-auto grid min-w-0 max-w-6xl items-end gap-10 px-5 py-16 md:py-24 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]">
      <div class="min-w-0">
        <p class="text-xs tracking-[0.18em] text-gold-soft uppercase">1967 — onward · {site.location}</p>
        <h1 class="mt-4 max-w-xl font-display text-5xl leading-[0.95] sm:text-7xl">
          Fifty years inside the machine.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-8 text-foam/85">
          Brian L. Pitre has founded companies, run sales forces, and sold the computers of each decade — IBM mainframes, minicomputers, personal computers, the commercial internet, and drone training.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a class="bg-gold-soft px-5 py-3 text-center text-sm text-sea-deep sm:text-left" href={href("/biography/")}>Read the biography</a>
          <a class="border border-gold-soft/50 px-5 py-3 text-center text-sm sm:text-left" href={href("/timeline/")}>Walk the timeline</a>
        </div>
      </div>
      <figure class="min-w-0">
        <Photo
          variant="water"
          priority
          alt="Brian Pitre seated on a boat, holding a large silver fish with a yellow tail, under a bright scattered sky."
          class="rounded-sm"
          sizes="(min-width: 1024px) 34rem, 100vw"
        />
        <figcaption class="mt-3 text-sm text-gold-soft/80">Brian Pitre, on the water. February 2025.</figcaption>
      </figure>
    </div>
    <nav aria-label="Decades" class="border-t border-white/10">
      <ul class="mx-auto flex max-w-6xl flex-wrap gap-x-5 gap-y-2 px-5 py-4 text-xs tracking-[0.14em] text-gold-soft uppercase">
        {chapters.map((chapter) => (
          <li>
            <a class="inline-block py-1 hover:text-foam" href={`#${chapter.id}`}>{chapter.kicker}</a>
          </li>
        ))}
      </ul>
    </nav>
  </section>

  <section class="mx-auto grid max-w-6xl gap-8 px-5 py-16 md:grid-cols-3">
    <p class="font-display text-3xl leading-tight text-sea md:col-span-2">
      The record is a chain of promotions and startups, not a single product. Each stop sits on the hardware of its decade.
    </p>
    <dl class="grid grid-cols-2 gap-4 border-t border-line pt-4 md:border-t-0 md:border-l md:pt-0 md:pl-6">
      <div>
        <dt class="text-xs tracking-[0.16em] text-muted uppercase">In the industry</dt>
        <dd class="font-display text-4xl text-sea">50+</dd>
        <dd class="text-sm text-muted">years, as he records it</dd>
      </div>
      <div>
        <dt class="text-xs tracking-[0.16em] text-muted uppercase">Founded</dt>
        <dd class="font-display text-4xl text-sea">{foundedCount}</dd>
        <dd class="text-sm text-muted">companies, founder or co-founder</dd>
      </div>
    </dl>
  </section>

  <div class="mx-auto max-w-6xl px-5">
    {
      chapters.map((chapter, index) => (
        <section id={chapter.id} class="rise grid min-w-0 items-center gap-8 border-t border-line py-14 md:grid-cols-2">
          <div class:list={[index % 2 === 1 && "md:order-2"]}>
            <p class="text-xs tracking-[0.18em] text-gold uppercase">{chapter.years}</p>
            <h2 class="mt-2 font-display text-4xl text-sea">{chapter.title}</h2>
            <p class="mt-2 text-sm text-muted">{chapter.kicker}</p>
            <p class="mt-4 max-w-prose leading-7">{chapter.text}</p>
            <a class="mt-5 inline-block text-sm underline decoration-gold underline-offset-4" href={href(chapter.href)}>
              Continue
            </a>
          </div>
          {
            chapter.id === "drones" ? (
              <figure class="min-w-0">
                <Photo
                  variant="class"
                  alt="Brian Pitre standing at the front of a classroom, teaching a SkyOp Introduction to sUAS session. A projector behind him shows the SkyOp name."
                  sizes="(min-width: 768px) 32rem, 100vw"
                />
                <figcaption class="mt-2 text-sm text-muted">Teaching SkyOp’s Introduction to sUAS.</figcaption>
              </figure>
            ) : (
              <p class="font-display text-[5.5rem] leading-none text-sea/15 sm:text-[7rem]" aria-hidden="true">
                {chapter.years.slice(0, 4)}
              </p>
            )
          }
        </section>
      ))
    }
  </div>

  <section class="bg-foam">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <div class="flex items-end justify-between gap-4">
        <h2 class="font-display text-4xl text-sea">Selected ventures</h2>
        <a class="text-sm underline decoration-gold underline-offset-4" href={href("/ventures/")}>All companies</a>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {
          ventures.map((venture) => (
            <a class="block border border-line bg-paper p-5 transition-colors hover:border-gold" href={href(`/ventures/${venture.slug}/`)}>
              <p class="text-xs tracking-[0.16em] text-gold uppercase">{venture.years}</p>
              <h3 class="mt-3 font-display text-2xl text-sea">{venture.org}</h3>
              <p class="mt-2 text-sm text-muted">{venture.role}</p>
              <p class="mt-4 text-sm leading-6">{venture.lede}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-sea text-foam">
    <div class="mx-auto grid max-w-6xl gap-6 px-5 py-16 md:grid-cols-[1.2fr_0.8fr] md:items-center">
      <div>
        <p class="text-xs tracking-[0.18em] text-gold-soft uppercase">United States Army · 1968–1971</p>
        <h2 class="mt-3 font-display text-4xl">Service, then back to the machine room.</h2>
        <p class="mt-4 max-w-xl leading-7 text-foam/85">
          Cryptographic equipment repair, a Top Secret clearance with crypto access, and Vietnam in 1969 and 1970. The years sit inside the Graphic Controls career as military leave.
        </p>
        <a class="mt-6 inline-block border border-gold-soft/50 px-5 py-3 text-sm" href={href("/military/")}>Military service</a>
      </div>
      <div class="border border-white/15 p-6">
        <p class="font-display text-3xl">{site.phoneDisplay}</p>
        <p class="mt-2 text-sm text-gold-soft">{site.location}</p>
        <a class="mt-5 inline-block text-sm underline decoration-gold-soft underline-offset-4" href={href("/contact/")}>Contact</a>
      </div>
    </div>
  </section>
</Base>
