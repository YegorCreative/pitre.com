---
import Base from "../layouts/Base.astro";
import { href } from "../data/site";
---

<Base title="Page not found" description="That page is not on pitre.com.">
  <div class="mx-auto max-w-3xl px-5 py-24">
    <p class="text-xs tracking-[0.18em] text-gold uppercase">404</p>
    <h1 class="mt-3 font-display text-5xl text-sea">This page is not in the record.</h1>
    <p class="mt-4 leading-7">The address does not match a page on this site.</p>
    <a class="mt-6 inline-block underline decoration-gold underline-offset-4" href={href("/")}>Back to the opening</a>
  </div>
</Base>
