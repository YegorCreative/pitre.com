---
import { href, site } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-sea-deep text-foam">
  <div class="mx-auto grid max-w-6xl gap-8 px-5 py-12 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-display text-2xl">{site.name}</p>
      <p class="mt-3 max-w-sm text-sm leading-6 text-gold-soft/90">{site.resumeNote}</p>
    </div>
    <div>
      <p class="text-xs tracking-[0.18em] text-gold-soft uppercase">Visit</p>
      <ul class="mt-3 grid gap-2 text-sm">
        <li><a class="hover:underline" href={href("/timeline/")}>Career timeline</a></li>
        <li><a class="hover:underline" href={href("/ventures/")}>Companies</a></li>
        <li><a class="hover:underline" href={href("/contact/")}>Contact</a></li>
      </ul>
    </div>
    <div>
      <p class="text-xs tracking-[0.18em] text-gold-soft uppercase">Reach</p>
      <p class="mt-3 text-sm leading-6">
        {site.location}<br />
        <a class="underline decoration-gold-soft/60 underline-offset-4" href={site.phoneHref}>{site.phoneDisplay}</a>
      </p>
    </div>
  </div>
  <div class="border-t border-white/10">
    <p class="mx-auto flex max-w-6xl flex-wrap gap-x-4 gap-y-1 px-5 py-4 text-xs text-gold-soft/70">
      <span>© {year} {site.name}. The home address is not published on this site.</span>
      <span>
        Built by
        <a class="underline decoration-gold-soft/50 underline-offset-4 hover:text-foam" href="https://yegorcreative.com" rel="noopener noreferrer">www.yegorcreative.com</a>
      </span>
    </p>
  </div>
</footer>
